        obs["donor"] = "unknown"
        return obs
    def _split(b):
        b = str(b)
        d_idx = b.find("d")
        if d_idx > 0:
            return b[1:d_idx], b[d_idx + 1:]
        return b, b
    obs["day"], obs["donor"] = zip(*obs[batch_col].astype(str).map(_split))
    return obs


